#: filter-guard-for-woocommerce.php:270
msgid "Off - no SEO or protection changes"
msgstr "خاموش - بدون تغییر در سئو یا محافظت"

#: filter-guard-for-woocommerce.php:271
msgid "SEO Soft Mode - noindex/canonical with optional high-score redirect/block"
msgstr "حالت سئوی نرم - noindex/canonical همراه با امکان ریدایرکت یا بلاک برای امتیازهای بالا"

#: filter-guard-for-woocommerce.php:272
msgid "Monitor Only - log and score only, no SEO tags/cookies/robots/blocking"
msgstr "فقط پایش - فقط ثبت و امتیازدهی، بدون تگ سئو، کوکی، robots یا بلاک"

#: filter-guard-for-woocommerce.php:273
msgid "Protection - require signed human cookie"
msgstr "محافظت - نیازمند کوکی انسانی امضاشده"

#: filter-guard-for-woocommerce.php:274
msgid "Protection - require signed human cookie + internal referer"
msgstr "محافظت - نیازمند کوکی انسانی امضاشده + ارجاع‌دهنده داخلی"

#: filter-guard-for-woocommerce.php:275
msgid "Strict - block protected filtered URLs except allowlists"
msgstr "سخت‌گیرانه - بلاک کردن URLهای فیلترشده محافظت‌شده به‌جز موارد مجاز"

#: filter-guard-for-woocommerce.php:276
msgid "Emergency - lightweight block for protected filtered URLs"
msgstr "اضطراری - بلاک سبک برای URLهای فیلترشده محافظت‌شده"

#: filter-guard-for-woocommerce.php:749 filter-guard-for-woocommerce.php:749 filter-guard-for-woocommerce.php:1012
msgid "Filter Guard for WooCommerce"
msgstr "محافظ فیلتر برای ووکامرس"

#: filter-guard-for-woocommerce.php:770
msgid "Blocking .htaccess rules are not written while protection mode is Off, Monitor, or SEO Soft Mode. Switch to Cookie, Cookie + Referer, Strict, or Emergency first."
msgstr "قوانین بلاک .htaccess در حالت خاموش، پایش یا سئوی نرم نوشته نمی‌شوند. ابتدا به حالت کوکی، کوکی + Referer، سخت‌گیرانه یا اضطراری تغییر دهید."

#: filter-guard-for-woocommerce.php:774
msgid ".htaccess guard written."
msgstr "محافظ .htaccess نوشته شد."

#: filter-guard-for-woocommerce.php:774
msgid "Could not write .htaccess guard. Validate regex settings and file permissions."
msgstr "امکان نوشتن محافظ .htaccess وجود نداشت. تنظیمات regex و دسترسی فایل‌ها را بررسی کنید."

#: filter-guard-for-woocommerce.php:779
msgid ".htaccess guard removed."
msgstr "محافظ .htaccess حذف شد."

#: filter-guard-for-woocommerce.php:779
msgid "Could not remove .htaccess guard. Check file permissions."
msgstr "امکان حذف محافظ .htaccess وجود نداشت. دسترسی فایل‌ها را بررسی کنید."

#: filter-guard-for-woocommerce.php:785
msgid "robots.txt rules are not written while protection mode is Off or Monitor. Use SEO Soft Mode or a blocking mode first."
msgstr "قوانین robots.txt در حالت خاموش یا پایش نوشته نمی‌شوند. ابتدا از حالت سئوی نرم یا یکی از حالت‌های بلاک استفاده کنید."

#: filter-guard-for-woocommerce.php:789
msgid "robots.txt rules written."
msgstr "قوانین robots.txt نوشته شد."

#: filter-guard-for-woocommerce.php:789
msgid "Could not write robots.txt rules. Check file permissions."
msgstr "امکان نوشتن قوانین robots.txt وجود نداشت. دسترسی فایل‌ها را بررسی کنید."

#: filter-guard-for-woocommerce.php:794
msgid "robots.txt rules removed."
msgstr "قوانین robots.txt حذف شد."

#: filter-guard-for-woocommerce.php:794
msgid "Could not remove robots.txt rules. Check file permissions."
msgstr "امکان حذف قوانین robots.txt وجود نداشت. دسترسی فایل‌ها را بررسی کنید."

#: filter-guard-for-woocommerce.php:802
msgid "Self-tests completed successfully."
msgstr "خودآزمایی‌ها با موفقیت کامل شدند."

#: filter-guard-for-woocommerce.php:802
msgid "Self-tests completed, but at least one policy check failed. Review the Health Check table before enabling stricter modes."
msgstr "خودآزمایی‌ها کامل شدند، اما حداقل یک بررسی سیاست ناموفق بود. پیش از فعال‌سازی حالت‌های سخت‌گیرانه‌تر، جدول بررسی سلامت را مرور کنید."

#: filter-guard-for-woocommerce.php:807
msgid "Latest backup restored."
msgstr "آخرین نسخه پشتیبان بازیابی شد."

#: filter-guard-for-woocommerce.php:807
msgid "Could not restore latest backup."
msgstr "امکان بازیابی آخرین نسخه پشتیبان وجود نداشت."

#: filter-guard-for-woocommerce.php:813
msgid "Cookie secret rotated. Existing human cookies are invalidated."
msgstr "راز کوکی تغییر کرد. کوکی‌های انسانی موجود نامعتبر شدند."

#: filter-guard-for-woocommerce.php:935
msgid "Settings saved and rules regenerated."
msgstr "تنظیمات ذخیره و قوانین دوباره تولید شدند."

#: filter-guard-for-woocommerce.php:935
msgid "Settings saved, but at least one filesystem operation failed. Check file permissions or remove/rewrite rules manually."
msgstr "تنظیمات ذخیره شد، اما حداقل یک عملیات فایل‌سیستم ناموفق بود. دسترسی فایل‌ها را بررسی کنید یا قوانین را دستی حذف/بازنویسی کنید."

#: filter-guard-for-woocommerce.php:1020
msgid "Live Dashboard"
msgstr "داشبورد زنده"

#: filter-guard-for-woocommerce.php:1022
msgid "PHP blocked 10m"
msgstr "بلاک‌شده PHP در ۱۰ دقیقه"

#: filter-guard-for-woocommerce.php:1023
msgid "PHP allowed 10m"
msgstr "مجاز PHP در ۱۰ دقیقه"

#: filter-guard-for-woocommerce.php:1024
msgid "PHP distinct IPs 10m"
msgstr "IPهای یکتای PHP در ۱۰ دقیقه"

#: filter-guard-for-woocommerce.php:1025
msgid "Mode"
msgstr "حالت"

#: filter-guard-for-woocommerce.php:1026
msgid "Server guard"
msgstr "محافظ سرور"

#: filter-guard-for-woocommerce.php:1026
msgid "Pre-PHP active"
msgstr "فعال پیش از PHP"

#: filter-guard-for-woocommerce.php:1026
msgid "PHP only / inactive"
msgstr "فقط PHP / غیرفعال"

#: filter-guard-for-woocommerce.php:1027
msgid "Average score 10m"
msgstr "میانگین امتیاز ۱۰ دقیقه"

#: filter-guard-for-woocommerce.php:1059
msgid "Quick operational snapshot for the last 10 minutes. These counters are PHP-level event-log counters. If Apache/LiteSpeed .htaccess guard blocks a request before WordPress loads, the request is protected but cannot be counted here; use server access logs for those pre-PHP hits."
msgstr "نمای عملیاتی سریع برای ۱۰ دقیقه گذشته. این شمارنده‌ها مربوط به رخدادهای سطح PHP هستند. اگر محافظ .htaccess در Apache/LiteSpeed درخواست را پیش از بارگذاری وردپرس بلاک کند، درخواست محافظت شده اما اینجا قابل شمارش نیست؛ برای آن بازدیدهای پیش از PHP از لاگ دسترسی سرور استفاده کنید."

#: filter-guard-for-woocommerce.php:1060
msgid "Shows the latest internal health checks. These tests verify the homepage, the configured WooCommerce shop/category test path, protected filtered URLs, cookie behavior, XML-RPC blocking, and robots.txt availability."
msgstr "آخرین بررسی‌های سلامت داخلی را نشان می‌دهد. این تست‌ها صفحه اصلی، مسیر تست فروشگاه/دسته‌بندی ووکامرس، URLهای فیلترشده محافظت‌شده، رفتار کوکی، بلاک XML-RPC و دسترس‌پذیری robots.txt را بررسی می‌کنند."

#: filter-guard-for-woocommerce.php:1061
msgid "Recent allow/block/noindex/mode/test events. This section helps you confirm which URLs matched the policy, which action was taken, and whether traffic looks like normal filtering or automated crawling."
msgstr "رخدادهای اخیر مجاز/بلاک/noindex/حالت/تست. این بخش کمک می‌کند ببینید کدام URLها با سیاست منطبق شده‌اند، چه اقدامی انجام شده و آیا ترافیک شبیه فیلتر عادی است یا خزیدن خودکار."

#: filter-guard-for-woocommerce.php:1062
msgid "Controls the main protection policy and the server-level guard. Start with Monitor Only to learn traffic patterns, use SEO Soft for indexing control, use Cookie mode for normal protection, and reserve Cookie + Referer, Strict, or Emergency for active floods."
msgstr "سیاست اصلی محافظت و محافظ سطح سرور را کنترل می‌کند. برای شناخت الگوی ترافیک با فقط پایش شروع کنید، برای کنترل ایندکس از سئوی نرم، برای محافظت عادی از حالت کوکی و برای حملات فعال از کوکی + Referer، سخت‌گیرانه یا اضطراری استفاده کنید."

#: filter-guard-for-woocommerce.php:1063
msgid "Defines how expensive a filtered archive URL is. More filter parameters, longer queries, and configured query keys increase the score. The score decides when cookies are required, when requests are blocked, and when emergency behavior should apply."
msgstr "مشخص می‌کند یک URL آرشیو فیلترشده چقدر پرهزینه است. تعداد پارامترهای فیلتر، طول query و کلیدهای تنظیم‌شده امتیاز را افزایش می‌دهند. امتیاز تعیین می‌کند چه زمانی کوکی لازم است، درخواست بلاک می‌شود یا رفتار اضطراری اعمال می‌گردد."

#: filter-guard-for-woocommerce.php:1064
msgid "Configures the lightweight first-party human cookie. Signed and rotating cookies make simple bot replay harder while keeping real visitors fast after their first valid page view. Very strict binding can affect visitors behind changing networks."
msgstr "کوکی انسانی سبک و first-party را تنظیم می‌کند. کوکی‌های امضاشده و چرخشی بازپخش ساده ربات‌ها را سخت‌تر می‌کنند و بازدیدکنندگان واقعی پس از اولین صفحه معتبر سریع‌تر عبور می‌کنند. اتصال بسیار سخت‌گیرانه می‌تواند کاربران پشت شبکه‌های متغیر را تحت تأثیر قرار دهد."

#: filter-guard-for-woocommerce.php:1065
msgid "Controls what the plugin records and how much personally identifiable data is stored. Hash or anonymize IPs for privacy, keep retention short, and enable sampling to avoid database pressure during large crawl floods."
msgstr "کنترل می‌کند افزونه چه چیزهایی را ثبت کند و چه مقدار داده قابل شناسایی ذخیره شود. برای حریم خصوصی IPها را هش یا ناشناس کنید، زمان نگهداری را کوتاه بگیرید و برای جلوگیری از فشار دیتابیس هنگام crawl flood بزرگ نمونه‌برداری را فعال کنید."

#: filter-guard-for-woocommerce.php:1066
msgid "Automatically escalates protection when traffic volume crosses configured thresholds, then returns to the base recovery mode after the site is quiet. Tune thresholds carefully so seasonal traffic spikes do not trigger aggressive blocking."
msgstr "وقتی حجم ترافیک از آستانه‌های تنظیم‌شده عبور کند، محافظت را خودکار تشدید می‌کند و پس از آرام شدن سایت به حالت بازیابی پایه برمی‌گردد. آستانه‌ها را با دقت تنظیم کنید تا جهش‌های فصلی باعث بلاک تهاجمی نشوند."

#: filter-guard-for-woocommerce.php:1067
msgid "Optional PHP-level rate limiting using WordPress transients or object cache. It is useful as a safety net, but high-volume attacks are better handled with .htaccess, Nginx, Cloudflare, or other edge/server rules."
msgstr "محدودسازی نرخ اختیاری در سطح PHP با transient یا object cache وردپرس. این گزینه به‌عنوان شبکه ایمنی مفید است، اما حملات سنگین بهتر است با .htaccess، Nginx، Cloudflare یا قوانین لبه/سرور مدیریت شوند."

#: filter-guard-for-woocommerce.php:1068
msgid "Validates declared search bots before trusting their user-agent names. This protects against fake Googlebot/Bingbot strings while allowing verified crawlers to receive gentler handling where appropriate."
msgstr "ربات‌های جست‌وجوی اعلام‌شده را پیش از اعتماد به نام User-Agent بررسی می‌کند. این کار در برابر Googlebot/Bingbot جعلی محافظت می‌کند و به خزنده‌های تأییدشده اجازه می‌دهد در صورت مناسب، برخورد ملایم‌تری دریافت کنند."

#: filter-guard-for-woocommerce.php:1069
msgid "Safety controls for rule deployment and cleanup. Health checks catch broken server rules after saving; rollback can restore the latest backup; uninstall cleanup controls whether generated files are removed when deleting the plugin."
msgstr "کنترل‌های ایمنی برای استقرار و پاک‌سازی قوانین. بررسی سلامت پس از ذخیره، قوانین خراب سرور را تشخیص می‌دهد؛ rollback می‌تواند آخرین پشتیبان را بازیابی کند؛ پاک‌سازی هنگام حذف مشخص می‌کند فایل‌های تولیدشده حذف شوند یا نه."

#: filter-guard-for-woocommerce.php:1070
msgid "Copy-ready Apache/LiteSpeed, Nginx, and Cloudflare rules for environments where automatic file writing is not possible or where edge blocking is preferred. Apply only the rule set that matches your server/CDN."
msgstr "قوانین آماده کپی برای Apache/LiteSpeed، Nginx و Cloudflare برای محیط‌هایی که نوشتن خودکار فایل ممکن نیست یا بلاک در لبه ترجیح دارد. فقط مجموعه قانونی را اعمال کنید که با سرور/CDN شما سازگار است."

#: filter-guard-for-woocommerce.php:1071
msgid "Lists backups created before the plugin changes managed files such as .htaccess, robots.txt, or blocked-light.html. Use these backups to recover quickly from a bad rule deployment."
msgstr "پشتیبان‌هایی را فهرست می‌کند که پیش از تغییر فایل‌های مدیریت‌شده مانند .htaccess، robots.txt یا blocked-light.html ساخته شده‌اند. از این پشتیبان‌ها برای بازیابی سریع پس از استقرار قانون اشتباه استفاده کنید."

#: filter-guard-for-woocommerce.php:1072
msgid "Manual maintenance tools for tests, rewriting/removing managed rules, restoring the latest backup, rotating cookie secrets, and exporting event logs. Use destructive actions carefully on production sites."
msgstr "ابزارهای نگهداری دستی برای تست‌ها، بازنویسی/حذف قوانین مدیریت‌شده، بازیابی آخرین پشتیبان، چرخش راز کوکی و خروجی گرفتن از لاگ رخدادها. عملیات مخرب را در سایت تولیدی با احتیاط انجام دهید."

#: filter-guard-for-woocommerce.php:1073
msgid "Main behavior switch. Monitor Only is safest for observation; SEO Soft adds indexing controls; Cookie mode protects filtered URLs while allowing real visitors; Cookie + Referer is stricter; Strict/Emergency are high-impact blocking modes."
msgstr "کلید اصلی رفتار افزونه. فقط پایش امن‌ترین حالت برای مشاهده است؛ سئوی نرم کنترل ایندکس را اضافه می‌کند؛ حالت کوکی از URLهای فیلترشده محافظت می‌کند و کاربران واقعی را عبور می‌دهد؛ کوکی + Referer سخت‌گیرانه‌تر است؛ سخت‌گیرانه/اضطراری حالت‌های بلاک پراثر هستند."

#: filter-guard-for-woocommerce.php:1074
msgid "The mode Auto Emergency returns to after the recovery period. Choose a stable everyday mode such as Monitor, SEO Soft, or Cookie; do not use Emergency as the recovery target."
msgstr "حالتی که Auto Emergency پس از دوره بازیابی به آن برمی‌گردد. یک حالت پایدار روزمره مانند پایش، سئوی نرم یا کوکی انتخاب کنید؛ اضطراری را هدف بازیابی قرار ندهید."

#: filter-guard-for-woocommerce.php:1075
msgid "When enabled on Apache/LiteSpeed, the plugin writes rewrite rules that block expensive filtered URLs before WordPress/PHP loads. This is faster than PHP blocking but cannot honor WordPress role allowlists."
msgstr "وقتی در Apache/LiteSpeed فعال باشد، افزونه قوانین rewrite می‌نویسد تا URLهای فیلترشده پرهزینه پیش از بارگذاری WordPress/PHP بلاک شوند. این روش از بلاک PHP سریع‌تر است اما نمی‌تواند فهرست نقش‌های مجاز وردپرس را رعایت کند."

#: filter-guard-for-woocommerce.php:1076
msgid "Blocks xmlrpc.php at PHP and managed .htaccess levels. Enable this when XML-RPC is not needed for Jetpack, mobile publishing, or legacy integrations."
msgstr "xmlrpc.php را در سطح PHP و .htaccess مدیریت‌شده بلاک می‌کند. زمانی فعال کنید که XML-RPC برای Jetpack، انتشار موبایلی یا یکپارچه‌سازی‌های قدیمی لازم نیست."

#: filter-guard-for-woocommerce.php:1077
msgid "HTTP response used for blocked requests. 403 clearly means forbidden; 404 hides the route from basic bots. Keep behavior consistent with your SEO and monitoring expectations."
msgstr "پاسخ HTTP استفاده‌شده برای درخواست‌های بلاک‌شده. 403 به‌روشنی یعنی ممنوع؛ 404 مسیر را از ربات‌های ساده پنهان می‌کند. رفتار را با انتظارات سئو و مانیتورینگ خود هماهنگ نگه دارید."

#: filter-guard-for-woocommerce.php:1078
msgid "Regular expression for URL paths that should be protected, usually WooCommerce shop/category archives. Keep it narrow, for example product-category and shop paths, so normal pages are not affected."
msgstr "عبارت منظم برای مسیرهای URL که باید محافظت شوند؛ معمولاً آرشیوهای فروشگاه/دسته‌بندی ووکامرس. آن را محدود نگه دارید، مثلاً مسیرهای product-category و shop، تا صفحات عادی تحت تأثیر قرار نگیرند."

#: filter-guard-for-woocommerce.php:1079
msgid "Regular expression for expensive query parameter names such as filter_*, query_type_*, price filters, ordering, stock status, and view changes. These keys identify layered-navigation crawl targets."
msgstr "عبارت منظم برای نام پارامترهای query پرهزینه مانند filter_*، query_type_*، فیلترهای قیمت، مرتب‌سازی، وضعیت موجودی و تغییر نما. این کلیدها اهداف crawl در layered navigation را مشخص می‌کنند."

#: filter-guard-for-woocommerce.php:1080
msgid "Optional legacy cookie-name compatibility for PHP checks only. Generated server/CDN rules use the current Filter Guard cookie names, and real validation still requires the signed HMAC cookie in PHP."
msgstr "سازگاری اختیاری با نام کوکی قدیمی فقط برای بررسی‌های PHP. قوانین تولیدشده سرور/CDN از نام کوکی فعلی Filter Guard استفاده می‌کنند و اعتبارسنجی واقعی همچنان نیازمند کوکی HMAC امضاشده در PHP است."

#: filter-guard-for-woocommerce.php:1081
msgid "IPs or CIDR/range patterns that bypass PHP-level checks. Use only for trusted admins, monitoring systems, or known internal networks. This does not bypass pre-PHP .htaccess blocking."
msgstr "IPها یا الگوهای CIDR/بازه که بررسی‌های سطح PHP را دور می‌زنند. فقط برای مدیران قابل اعتماد، سیستم‌های پایش یا شبکه‌های داخلی شناخته‌شده استفاده کنید. این گزینه بلاک pre-PHP در .htaccess را دور نمی‌زند."

#: filter-guard-for-woocommerce.php:1082
msgid "Optional PHP-level bypass for trusted user agents. Keep this very narrow because user-agent strings are easy to spoof unless combined with verified-bot checks."
msgstr "عبور اختیاری در سطح PHP برای User-Agentهای قابل اعتماد. این گزینه را بسیار محدود نگه دارید، چون رشته‌های User-Agent به‌راحتی جعل می‌شوند مگر اینکه با بررسی ربات تأییدشده ترکیب شوند."

#: filter-guard-for-woocommerce.php:1083
msgid "Comma-separated WordPress role slugs allowed through PHP-level protection. This is useful for admins/shop managers, but server-level .htaccess rules run before WordPress knows the user role."
msgstr "اسلاگ نقش‌های وردپرس، جداشده با کاما، که از محافظت سطح PHP عبور می‌کنند. برای مدیران/مدیران فروشگاه مفید است، اما قوانین .htaccess سطح سرور پیش از شناسایی نقش کاربر توسط وردپرس اجرا می‌شوند."

#: filter-guard-for-woocommerce.php:1084
msgid "Number of filter/query parameters allowed before the URL is considered too complex. Lower values are stricter; higher values allow deeper customer filtering but may increase crawl load."
msgstr "تعداد پارامترهای فیلتر/query مجاز پیش از اینکه URL بیش از حد پیچیده محسوب شود. مقدار کمتر سخت‌گیرانه‌تر است؛ مقدار بیشتر فیلتر عمیق‌تر برای مشتریان را مجاز می‌کند اما ممکن است بار crawl را افزایش دهد."

#: filter-guard-for-woocommerce.php:1085
msgid "Maximum full query-string length before extra score is added. Very long query strings often indicate crawler-generated combinations or attack traffic."
msgstr "حداکثر طول کامل query-string پیش از افزودن امتیاز اضافه. queryهای بسیار طولانی اغلب نشانه ترکیب‌های تولیدشده توسط خزنده یا ترافیک حمله هستند."

#: filter-guard-for-woocommerce.php:1086
msgid "Score level where the plugin starts requiring a valid human cookie in cookie-based modes. Set below the block score so real users can be challenged before being blocked."
msgstr "سطح امتیازی که افزونه در حالت‌های مبتنی بر کوکی، کوکی انسانی معتبر را لازم می‌کند. آن را پایین‌تر از امتیاز بلاک تنظیم کنید تا کاربران واقعی پیش از بلاک شدن چالش شوند."

#: filter-guard-for-woocommerce.php:1087
msgid "Score level where the plugin blocks a request in blocking modes. Increase this if legitimate filter combinations are being blocked; decrease it during severe floods."
msgstr "سطح امتیازی که افزونه در حالت‌های بلاک، درخواست را بلاک می‌کند. اگر ترکیب‌های فیلتر معتبر بلاک می‌شوند آن را افزایش دهید؛ هنگام flood شدید کاهش دهید."

#: filter-guard-for-woocommerce.php:1088
msgid "Very high score threshold that marks a request as emergency-level complexity. Use this to catch extreme filter combinations even before volume-based thresholds trigger."
msgstr "آستانه امتیاز بسیار بالا که درخواست را در سطح پیچیدگی اضطراری علامت‌گذاری می‌کند. از آن برای گرفتن ترکیب‌های فیلتر افراطی حتی پیش از فعال شدن آستانه‌های حجمی استفاده کنید."

#: filter-guard-for-woocommerce.php:1089
msgid "In SEO Soft Mode, filter URLs up to this score can receive noindex/canonical handling while higher-score URLs can be redirected to a clean URL or blocked, depending on the selected action."
msgstr "در حالت سئوی نرم، URLهای فیلتر تا این امتیاز می‌توانند noindex/canonical دریافت کنند و URLهای با امتیاز بالاتر بسته به اقدام انتخاب‌شده به URL تمیز ریدایرکت یا بلاک شوند."

#: filter-guard-for-woocommerce.php:1090
msgid "Sets a lightweight first-party HttpOnly cookie for real visitors. Cookie-based protection depends on this unless another trusted flow sets a compatible cookie."
msgstr "یک کوکی سبک first-party و HttpOnly برای بازدیدکنندگان واقعی تنظیم می‌کند. محافظت مبتنی بر کوکی به این گزینه وابسته است مگر اینکه جریان قابل اعتماد دیگری کوکی سازگار تنظیم کند."

#: filter-guard-for-woocommerce.php:1091
msgid "Base name for the human cookie. Keep the default unless you have a naming conflict or need to coordinate with existing server/CDN rules."
msgstr "نام پایه کوکی انسانی. مقدار پیش‌فرض را نگه دارید مگر اینکه تداخل نام دارید یا باید با قوانین موجود سرور/CDN هماهنگ شوید."

#: filter-guard-for-woocommerce.php:1092
msgid "Cookie lifetime in seconds. Shorter TTLs reduce replay window; longer TTLs reduce repeat challenges for real shoppers."
msgstr "طول عمر کوکی برحسب ثانیه. TTL کوتاه‌تر پنجره بازپخش را کاهش می‌دهد؛ TTL طولانی‌تر چالش‌های تکراری برای خریداران واقعی را کمتر می‌کند."

#: filter-guard-for-woocommerce.php:1093
msgid "Adds HMAC signing, optional daily name rotation, and optional binding to User-Agent or IP prefix. Stronger binding improves abuse resistance but can affect visitors whose browser/network changes frequently."
msgstr "امضای HMAC، چرخش اختیاری روزانه نام و اتصال اختیاری به User-Agent یا پیشوند IP را اضافه می‌کند. اتصال قوی‌تر مقاومت در برابر سوءاستفاده را بهتر می‌کند اما می‌تواند روی بازدیدکنندگانی که مرورگر/شبکه آن‌ها مرتب تغییر می‌کند اثر بگذارد."

#: filter-guard-for-woocommerce.php:1094
msgid "Enables recording of important plugin events such as blocked requests, allowed filtered requests, noindex decisions, mode changes, and self-tests."
msgstr "ثبت رخدادهای مهم افزونه مانند درخواست‌های بلاک‌شده، درخواست‌های فیلترشده مجاز، تصمیم‌های noindex، تغییر حالت و خودآزمایی‌ها را فعال می‌کند."

#: filter-guard-for-woocommerce.php:1095
msgid "Where events are stored. Database is easiest to review in WordPress; NDJSON file is useful for server-side analysis; Both gives redundancy but writes more data."
msgstr "محل ذخیره رخدادها. دیتابیس برای بررسی در وردپرس ساده‌تر است؛ فایل NDJSON برای تحلیل سمت سرور مفید است؛ هر دو افزونگی می‌دهد اما داده بیشتری می‌نویسد."

#: filter-guard-for-woocommerce.php:1096
msgid "Controls IP privacy in logs. Hash only is privacy-friendly, anonymized keeps partial troubleshooting value, and full IP should be used only when you need exact forensic data."
msgstr "حریم خصوصی IP در لاگ‌ها را کنترل می‌کند. فقط هش برای حریم خصوصی مناسب‌تر است، ناشناس‌سازی مقدار کمی برای عیب‌یابی حفظ می‌کند و IP کامل فقط زمانی استفاده شود که به داده دقیق forensic نیاز دارید."

#: filter-guard-for-woocommerce.php:1097
msgid "Number of days to keep logs before cleanup. Short retention reduces database size and privacy exposure; longer retention helps investigate recurring crawl patterns."
msgstr "تعداد روزهای نگهداری لاگ‌ها پیش از پاک‌سازی. نگهداری کوتاه حجم دیتابیس و ریسک حریم خصوصی را کاهش می‌دهد؛ نگهداری طولانی‌تر برای بررسی الگوهای crawl تکراری مفید است."

#: filter-guard-for-woocommerce.php:1098
msgid "Sampling rule for high traffic. After the configured events-per-minute threshold, the plugin records only one out of every N repetitive events while counters still drive protection decisions."
msgstr "قانون نمونه‌برداری برای ترافیک بالا. پس از آستانه رخداد در دقیقه تنظیم‌شده، افزونه فقط یکی از هر N رخداد تکراری را ثبت می‌کند، در حالی که شمارنده‌ها همچنان تصمیم‌های محافظتی را هدایت می‌کنند."

#: filter-guard-for-woocommerce.php:1099
msgid "Reduces repetitive per-request logging while Emergency mode is active. This protects the database and filesystem when the site is already under heavy crawl pressure."
msgstr "هنگام فعال بودن حالت اضطراری، لاگ‌نویسی تکراری برای هر درخواست را کاهش می‌دهد. این کار وقتی سایت زیر فشار crawl سنگین است، از دیتابیس و فایل‌سیستم محافظت می‌کند."

#: filter-guard-for-woocommerce.php:1100
msgid "Turns on automatic escalation to Strict/Emergency based on request volume and IP diversity. Keep disabled if you prefer manual mode changes only."
msgstr "تشدید خودکار به حالت سخت‌گیرانه/اضطراری را بر اساس حجم درخواست و تنوع IP فعال می‌کند. اگر فقط تغییر دستی حالت را ترجیح می‌دهید، آن را غیرفعال نگه دارید."

#: filter-guard-for-woocommerce.php:1101
msgid "Rolling time window used to count filtered and blocked requests for Auto Emergency decisions. Shorter windows react faster; longer windows are smoother but slower."
msgstr "پنجره زمانی لغزان برای شمارش درخواست‌های فیلترشده و بلاک‌شده در تصمیم‌های Auto Emergency. پنجره کوتاه‌تر سریع‌تر واکنش می‌دهد؛ پنجره بلندتر نرم‌تر اما کندتر است."

#: filter-guard-for-woocommerce.php:1102
msgid "Number of matched requests within the window required to move into Strict mode. Set above normal peak traffic but below flood levels."
msgstr "تعداد درخواست‌های منطبق در پنجره زمانی که برای ورود به حالت سخت‌گیرانه لازم است. آن را بالاتر از اوج ترافیک عادی و پایین‌تر از سطح flood تنظیم کنید."

#: filter-guard-for-woocommerce.php:1103
msgid "Number of matched or blocked requests within the window required to move into Emergency mode. This should be higher than the Strict threshold."
msgstr "تعداد درخواست‌های منطبق یا بلاک‌شده در پنجره زمانی که برای ورود به حالت اضطراری لازم است. این مقدار باید بالاتر از آستانه سخت‌گیرانه باشد."

#: filter-guard-for-woocommerce.php:1104
msgid "Minimum number of different IPs seen in the window before emergency escalation. Helps distinguish distributed crawl floods from one aggressive visitor or tool."
msgstr "حداقل تعداد IPهای متفاوت دیده‌شده در پنجره پیش از تشدید اضطراری. به تفکیک crawl flood توزیع‌شده از یک بازدیدکننده یا ابزار تهاجمی کمک می‌کند."

#: filter-guard-for-woocommerce.php:1105
msgid "Quiet period before Auto Emergency returns to the base recovery mode. Increase it if attacks come in waves; decrease it if you want faster recovery."
msgstr "دوره آرامش پیش از بازگشت Auto Emergency به حالت بازیابی پایه. اگر حملات موجی هستند آن را افزایش دهید؛ اگر بازیابی سریع‌تر می‌خواهید کاهش دهید."

#: filter-guard-for-woocommerce.php:1106
msgid "Enables PHP-level rate limits. Useful for moderate abuse, but not a replacement for server/CDN protection during high-volume floods because WordPress must still load."
msgstr "محدودسازی نرخ در سطح PHP را فعال می‌کند. برای سوءاستفاده متوسط مفید است، اما هنگام flood سنگین جایگزین محافظت سرور/CDN نیست، چون وردپرس همچنان باید بارگذاری شود."

#: filter-guard-for-woocommerce.php:1107
msgid "Maximum matching requests from one IP within the rate-limit window before temporary blocking starts."
msgstr "حداکثر درخواست‌های منطبق از یک IP در پنجره rate limit پیش از شروع بلاک موقت."

#: filter-guard-for-woocommerce.php:1108
msgid "Maximum matching requests from the same approximate network range within the window. Helps slow small bot clusters that rotate nearby IPs."
msgstr "حداکثر درخواست‌های منطبق از یک بازه شبکه تقریبی در همان پنجره. به کند کردن خوشه‌های کوچک ربات که IPهای نزدیک را می‌چرخانند کمک می‌کند."

#: filter-guard-for-woocommerce.php:1109
msgid "Length of the rate-limit counting window in seconds. Shorter windows are more responsive; longer windows are more tolerant but less immediate."
msgstr "طول پنجره شمارش rate limit بر حسب ثانیه. پنجره کوتاه‌تر پاسخ‌گوتر است؛ پنجره بلندتر تحمل بیشتری دارد اما فوری نیست."

#: filter-guard-for-woocommerce.php:1110
msgid "Temporary block duration after a rate limit is exceeded. Keep it long enough to cool down abuse but not so long that accidental blocks persist for hours."
msgstr "مدت بلاک موقت پس از عبور از rate limit. آن را به‌اندازه‌ای طولانی بگذارید که سوءاستفاده فروکش کند، اما نه آن‌قدر طولانی که بلاک‌های تصادفی ساعت‌ها باقی بمانند."

#: filter-guard-for-woocommerce.php:1111
msgid "Select which search bot families to verify and whether failed verification should be blocked. Verification is important because bot user-agent names can be forged."
msgstr "انتخاب کنید کدام خانواده‌های ربات جست‌وجو بررسی شوند و آیا شکست بررسی باید بلاک شود یا نه. بررسی مهم است، چون نام‌های User-Agent ربات‌ها قابل جعل هستند."

#: filter-guard-for-woocommerce.php:1112
msgid "How long successful bot verification is cached. Higher values reduce DNS/verification overhead; lower values refresh identity checks more often."
msgstr "مدت کش شدن بررسی موفق ربات. مقدار بالاتر هزینه DNS/verification را کاهش می‌دهد؛ مقدار پایین‌تر بررسی هویت را بیشتر تازه‌سازی می‌کند."

#: filter-guard-for-woocommerce.php:1113
msgid "Maximum complexity score allowed for verified bots before normal protection applies. Use this to keep legitimate crawlers from exploring extremely expensive filter combinations."
msgstr "حداکثر امتیاز پیچیدگی مجاز برای ربات‌های تأییدشده پیش از اعمال محافظت عادی. از این گزینه برای جلوگیری از کاوش ترکیب‌های فیلتر بسیار پرهزینه توسط خزنده‌های معتبر استفاده کنید."

#: filter-guard-for-woocommerce.php:1114
msgid "Runs self-tests after writing managed files. If rollback is enabled and tests fail, the plugin restores the latest backup to avoid leaving broken blocking rules active."
msgstr "پس از نوشتن فایل‌های مدیریت‌شده خودآزمایی اجرا می‌کند. اگر rollback فعال باشد و تست‌ها ناموفق شوند، افزونه برای جلوگیری از فعال ماندن قوانین خراب، آخرین پشتیبان را بازیابی می‌کند."

#: filter-guard-for-woocommerce.php:1115
msgid "Clean WooCommerce shop or category path used for tests before filter parameters are added. It must return 200 so the plugin can distinguish real rule problems from missing pages."
msgstr "مسیر تمیز فروشگاه یا دسته‌بندی ووکامرس که برای تست‌ها پیش از افزودن پارامترهای فیلتر استفاده می‌شود. باید 200 برگرداند تا افزونه بتواند مشکل واقعی قوانین را از صفحه گم‌شده تشخیص دهد."

#: filter-guard-for-woocommerce.php:1116
msgid "Controls cleanup on plugin deletion. Enable when you want .htaccess, robots.txt, and blocked-light.html changes removed automatically during uninstall."
msgstr "پاک‌سازی هنگام حذف افزونه را کنترل می‌کند. زمانی فعال کنید که می‌خواهید تغییرات .htaccess، robots.txt و blocked-light.html هنگام uninstall به‌صورت خودکار حذف شوند."

