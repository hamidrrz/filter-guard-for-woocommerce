# Filter Guard for WooCommerce - Git ignore rules
# Keep this file in the repository root.

# -----------------------------------------------------------------------------
# OS / filesystem noise
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.Spotlight-V100/
.Trashes/

# -----------------------------------------------------------------------------
# Editors / IDEs
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Environment / secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.ovpn

# -----------------------------------------------------------------------------
# PHP / Composer
# -----------------------------------------------------------------------------
/vendor/
composer.phar
.phpunit.result.cache
.phpunit.cache/
.phpcs-cache
.phpcs.cache
.php-cs-fixer.cache
.phpstan.cache/
.psalm/cache/

# Keep lock files trackable when present.
!composer.lock

# -----------------------------------------------------------------------------
# Node / frontend tooling
# -----------------------------------------------------------------------------
/node_modules/
/.npm/
/.yarn/cache/
/.yarn/unplugged/
/.yarn/build-state.yml
/.yarn/install-state.gz
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Keep lock files trackable when present.
!package-lock.json
!pnpm-lock.yaml
!yarn.lock

# -----------------------------------------------------------------------------
# Build / release artifacts
# -----------------------------------------------------------------------------
/dist/
/build/
/release/
/releases/
/tmp/
/temp/
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# -----------------------------------------------------------------------------
# WordPress local/runtime files
# -----------------------------------------------------------------------------
wp-config.php
wp-config-local.php
/wp-content/uploads/
/wp-content/cache/
/wp-content/upgrade/
/wp-content/backup*/
/wp-content/backups*/
/wp-content/debug.log

# -----------------------------------------------------------------------------
# Plugin runtime data: never commit logs, events, backups, counters, generated files
# -----------------------------------------------------------------------------
/wp-content/filter-guard-for-woocommerce/
/wp-content/cache/filter-guard-for-woocommerce/
filter-guard-for-woocommerce/events/
filter-guard-for-woocommerce/backups/
filter-guard-for-woocommerce/runtime/
filter-guard-for-woocommerce/*.log
filter-guard-for-woocommerce/*.ndjson

# Generated by plugin at site public root; do not commit from local WP installs.
blocked-light.html

# -----------------------------------------------------------------------------
# Logs / databases / local dumps
# -----------------------------------------------------------------------------
*.log
*.sql
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.backup
*.orig

# -----------------------------------------------------------------------------
# Test / coverage output
# -----------------------------------------------------------------------------
/coverage/
/.coverage/
/tests/_output/
/tests/_support/_generated/

# -----------------------------------------------------------------------------
# Local archives and temporary downloads
# -----------------------------------------------------------------------------
*.download
*.part
*.tmp
*.temp
